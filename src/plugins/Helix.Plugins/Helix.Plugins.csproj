<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Helix.Plugins</AssemblyName>
    <RootNamespace>Helix.Plugins</RootNamespace>

    <!-- ADR-003: plug-in packages do not require signing. Do not change this. -->
    <SignAssembly>false</SignAssembly>

    <!-- ONE-WAY DOOR. PackageId and Version are fixed on the server at first
         registration and cannot be changed afterwards by any API call [D5]. -->
    <PackageId>nexacorp_Helix.Plugins</PackageId>
    <Version>1.0.0</Version>

    <!-- ONE-WAY DOOR OF A DIFFERENT SHAPE. Changing major or minor makes this a
         DIFFERENT assembly to Dataverse and orphans every existing step [D4].
         For the whole of Phase 1, move only the third and fourth numbers. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <Authors>NexaCorp Helix</Authors>
    <Description>Helix case-management plug-ins: SetCaseReference, SetVulnerablePriority, GuardCaseClose.</Description>

    <!-- The SDK assemblies already exist in the sandbox runtime and must not be
         carried in, or declared as dependencies of, the package [D5]. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.*" PrivateAssets="all" />
  </ItemGroup>

</Project>