cat > .gitignore <<'EOF'
# ---- Secrets: never commit anything matching these ----
*.env
.env
.env.*
local.settings.json
appsettings.Development.json
appsettings.Local.json
*.publishsettings
*.pfx
*.pem
*.key
secrets.json
**/secrets/**

# ---- .NET build output (plugins, Azure Functions) ----
bin/
obj/
*.user
*.suo
*.userprefs
project.lock.json
artifacts/

# ---- Node / PCF ----
node_modules/
out/
dist/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

# ---- PAC CLI / solution tooling ----
*.zip
.pac/
Entities/**/bin/
PowerAppsTools_*/

# ---- Azure Functions local ----
local.settings.json
.azure/
.python_packages/

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
._*

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
EOF

# --- .NET (added Stage 1) ---
bin/
obj/
*.user
*.suo
*.userprefs
.vs/
*.snk
*.pfx
*.nupkg
outputPackages/

# --- Node / PCF (added Stage 1) ---
node_modules/
dist/
out/
npm-debug.log*

# --- Azure Functions local settings (added Stage 1, NFR-SEC-01) ---
local.settings.json

# --- macOS ---
.DS_Store
